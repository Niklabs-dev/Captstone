{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsc -p tsconfig.test.json \u0026\u0026 node --test .test-build/auth.test.js",
    "test:integration": "tsc -p tsconfig.test.json \u0026\u0026 node --test .test-build/auth-flow.integration.test.js",
    "test:live": "tsc -p tsconfig.test.json \u0026\u0026 node --test .test-build/auth-live.integration.test.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs}\"",
    "test:portal": "tsc -p tsconfig.test.json \u0026\u0026 node --test .test-build/navigation.test.js",
    "test:portal:e2e": "playwright test --config=playwright.portal.config.ts",
    "test:audit": "tsc -p tsconfig.test.json \u0026\u0026 node --test .test-build/audit.test.js",
    "test:audit:integration": "tsc -p tsconfig.test.json \u0026\u0026 node --test .test-build/audit-http.integration.test.js",
    "test:audit:e2e": "playwright test --config=playwright.audit.config.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
