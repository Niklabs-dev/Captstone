{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/auth.test.js",
    "test:integration": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/auth-flow.integration.test.js",
    "test:live": "tsc -p tsconfig.test.json && node --test .test-build/auth-live.integration.test.js",
    "format": "prettier --write src \"*.{ts,mjs}\"",
    "format:check": "prettier --check src \"*.{ts,mjs}\"",
    "test:portal": "tsc -p tsconfig.test.json && node --test .test-build/navigation.test.js",
    "test:portal:e2e": "playwright test --config=playwright.portal.config.ts",
    "test:audit": "tsc -p tsconfig.test.json && node --test .test-build/audit.test.js",
    "test:audit:integration": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/audit-http.integration.test.js",
    "test:audit:e2e": "playwright test --config=playwright.audit.config.ts",
    "test:users": "tsc -p tsconfig.users-test.json && node --test .users-test-build/users.test.js",
    "test:users:integration": "npm run build && tsc -p tsconfig.users-test.json && node --test .users-test-build/users-http.integration.test.js",
    "test:users:e2e": "playwright test --config playwright.users.config.ts",
    "test:users:real": "playwright test --config playwright.user-management.config.ts",
    "test:documents": "tsc -p tsconfig.test.json && node --test .test-build/documents.test.js",
    "test:documents:e2e": "playwright test --config playwright.documents.config.ts",
    "test:my-documents": "tsc -p tsconfig.test.json && node --test .test-build/my-documents.test.js .test-build/documents.test.js .test-build/navigation.test.js",
    "test:my-documents:real": "playwright test --config playwright.my-documents.config.ts",
    "test:dt-alerts": "tsc -p tsconfig.test.json && node --test .test-build/dt-alerts.test.js",
    "test:dt-alerts:e2e": "playwright test --config playwright.dt-alerts.config.ts",
    "test:payroll": "tsc -p tsconfig.test.json && node --test .test-build/payroll.test.js",
    "test:payroll:e2e": "playwright test --config playwright.payroll.config.ts",
    "test:my-payslips": "tsc -p tsconfig.test.json && node --test .test-build/my-payslips.test.js",
    "test:my-payslips:e2e": "playwright test --config playwright.my-payslips.config.ts",
    "test:stores": "tsc -p tsconfig.test.json && node --test .test-build/stores.test.js .test-build/navigation.test.js",
    "test:stores:e2e": "playwright test --config playwright.stores.config.ts",
    "test:tips": "tsc -p tsconfig.test.json && node --test .test-build/tips.test.js .test-build/navigation.test.js",
    "test:tips:integration": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/tips-http.integration.test.js",
    "test:tips:real": "playwright test --config playwright.tips.config.ts",
    "test:my-tip-receipts": "tsc -p tsconfig.test.json && node --test .test-build/my-tip-receipts.test.js .test-build/navigation.test.js",
    "test:my-tip-receipts:real": "playwright test --config playwright.my-tip-receipts.config.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
