# URL base de la API del backend NestJS
# OJO: las variables NEXT_PUBLIC_* se exponen al navegador; nunca poner secretos aquí
NEXT_PUBLIC_API_URL=http://localhost:3001

# Solo para el servidor de Next.js. En Docker: http://backend:3001.
BACKEND_INTERNAL_URL=http://localhost:3001

# Segundos de duración de la cookie; alinear con JWT_REFRESH_EXPIRES_IN del backend.
AUTH_REFRESH_COOKIE_MAX_AGE=604800

# Solo para npm run test:live; utilizar una cuenta del entorno de pruebas.
# No guardar credenciales reales en este archivo ni en Git.
TEST_FRONTEND_URL=http://localhost:3000
TEST_AUTH_EMAIL=
TEST_AUTH_PASSWORD=
# Solo para pruebas contra el Docker exclusivo de SPRINT-1-T11.
# Deben coincidir con ADMIN_EMAIL y ADMIN_PASSWORD del seed de ese entorno.
TEST_PORTAL_ADMIN_EMAIL=
TEST_PORTAL_ADMIN_PASSWORD=
# scripts/test-portal.ps1 configura estas variables automáticamente.
TEST_PORTAL_FRONTEND_URL=http://localhost:3104
TEST_PORTAL_BACKEND_URL=http://localhost:3105
TEST_PORTAL_STORE_ID=
TEST_PORTAL_DISPOSABLE=false
# Catálogo opcional de locales reales para auditoría. Nunca usar UUID ficticios
# en producción. Complementa los locales asociados a usuarios y registros.
AUDIT_STORES=[]
# Solo para el entorno Docker exclusivo de SPRINT-1-T16.
TEST_AUDIT_ADMIN_EMAIL=
TEST_AUDIT_ADMIN_PASSWORD=
TEST_AUDIT_FRONTEND_URL=http://localhost:3106
TEST_AUDIT_BACKEND_URL=http://localhost:3107
TEST_AUDIT_STORE_ID=
TEST_AUDIT_OTHER_STORE_ID=
TEST_AUDIT_DISPOSABLE=false

# Catálogo opcional de locales existentes y activos: [{"id":"UUID_REAL","name":"Nombre"}].
# Los locales asociados a usuarios existentes se incorporan automáticamente.
USER_MANAGEMENT_STORES=[]

# Pruebas Playwright contra un entorno Docker exclusivo (scripts/test-users.ps1).
TEST_USERS_FRONTEND_URL=http://localhost:3102
TEST_USERS_BACKEND_URL=http://localhost:3103
TEST_USERS_ADMIN_EMAIL=
TEST_USERS_ADMIN_PASSWORD=
TEST_USERS_STORE_ID=
TEST_USERS_DISPOSABLE=false

# Regresión de navegación compartida: solo contra un Docker exclusivo de pruebas.
TEST_NAVIGATION_FRONTEND_URL=http://127.0.0.1:3000
TEST_NAVIGATION_BACKEND_URL=http://127.0.0.1:3001
TEST_NAVIGATION_ADMIN_EMAIL=
TEST_NAVIGATION_ADMIN_PASSWORD=
TEST_NAVIGATION_STORE_ID=
TEST_NAVIGATION_DISPOSABLE=false

# Revisión visual: imagen de pruebas conectada al proxy separado, nunca a producción.
TEST_UI_FRONTEND_URL=http://127.0.0.1:3115
TEST_UI_PROXY_CONTROL_URL=http://127.0.0.1:3149/__test/state
TEST_UI_ADMIN_EMAIL=
TEST_UI_ADMIN_PASSWORD=
TEST_UI_DISPOSABLE=false
# Destino del proxy de pruebas dentro de la red Docker exclusiva.
TEST_PROXY_UPSTREAM=http://backend:3001
