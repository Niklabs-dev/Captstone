# Para `npm run dev` fuera de Docker, el backend corre en localhost:3001
# (según docker-compose.yml) y no hace falta configurar nada: session.ts
# usa 'http://localhost:3001' como valor por defecto.
#
# Dentro de docker compose, el frontend debe alcanzar al backend por el
# nombre del servicio, no por localhost — hay que agregar esta variable
# al servicio `frontend` en el docker-compose.yml de la raíz:
BACKEND_INTERNAL_URL=http://backend:3001

# Usada por el navegador si en el futuro se agregan fetches directos desde
# el cliente (hoy no se usa: todo pasa por Route Handlers server-to-server
# para evitar CORS, que el backend no tiene habilitado).
NEXT_PUBLIC_API_URL=http://localhost:3001
