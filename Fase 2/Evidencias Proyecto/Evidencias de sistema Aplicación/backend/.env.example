# Puerto donde escucha la API del backend
PORT=3001

# Base de datos PostgreSQL (docker compose la publica en el puerto 5433 del host;
# dentro de la red Docker el backend la alcanza en db:5432)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=cambiar-en-produccion
DB_NAME=subway_gestion

# URL de conexión para Prisma (CLI y cliente).
# Local: apunta al PostgreSQL de docker compose (puerto 5433 del host).
# Dentro de Docker: postgresql://postgres:cambiar-en-produccion@db:5432/subway_gestion
DATABASE_URL=postgresql://postgres:cambiar-en-produccion@localhost:5433/subway_gestion

# URL de conexión SOLO para los tests de integración (test/database.integration.spec.ts).
# Los tests se revierten en cada transacción; usar la base de desarrollo o una dedicada.
TEST_DATABASE_URL=postgresql://postgres:cambiar-en-produccion@localhost:5433/subway_gestion

# Carpeta donde el gestor documental guarda los archivos (ruta absoluta o
# relativa a backend/). En Docker es el volumen documents_data montado en
# /app/storage/documents. Nunca dentro de src/ ni de una carpeta pública.
# Las fotos de voucher de la operación diaria (SPRINT-4R-T01) viven en la
# subcarpeta vouchers/ de este mismo volumen: almacenamiento privado que solo
# se descarga autenticado por GET /daily-operations/:id/voucher.
DOCUMENTS_STORAGE_PATH=./storage/documents
# Tamaño máximo por archivo del gestor documental, en MB: entero entre 1 y 100
# (por defecto 25; debe coincidir con el frontend).
DOCUMENTS_MAX_SIZE_MB=25

# Autenticación JWT
# NUNCA commitear valores reales; generar un secreto largo y aleatorio por ambiente
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1d
# Vida del refresh token (30m, 12h, 7d...). Al renovarlo, el anterior queda revocado.
JWT_REFRESH_EXPIRES_IN=7d

# Seed: usuario administrador inicial (npm run prisma:seed). El seed es
# idempotente: si el correo ya existe, el usuario se mantiene sin cambios.
# NUNCA usar la contraseña por defecto en producción; cambiarla en el primer inicio.
ADMIN_EMAIL=admin@moi-food.cl
ADMIN_PASSWORD=admin-cambiar-en-produccion
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Moi-food

# Datos sintéticos de propinas para desarrollo y pruebas. Solo se siembran
# cuando es exactamente true; debe permanecer false en producción/Coolify.
SEED_DEMO_DATA=false

# Días legales de pago de las propinas diarias (SPRINT-4A-T22), en días
# hábiles (lunes a viernes sin los feriados de TIP_ALERT_HOLIDAYS) contados
# desde el día siguiente a la fecha de la propina. Una propina No pagada con
# más días que estos genera alerta. Por defecto 7: el séptimo día hábil de la
# alerta legal original (SPRINT-3-T14); se amplía si el convenio pacta pagar en
# más días. Entero entre 1 y 260; vacío usa 7 y un valor inválido impide iniciar.
TIP_LEGAL_PAYMENT_DAYS=7

# Feriados chilenos para el plazo de pago de propinas (TIP_LEGAL_PAYMENT_DAYS).
# Lista anual separada por comas, con fechas válidas YYYY-MM-DD (sin comillas).
# Revisar y actualizar el calendario oficial cada año; vacío significa sin feriados.
# Ejemplo: TIP_ALERT_HOLIDAYS=2026-01-01,2026-05-01,2026-09-18,2026-12-25
TIP_ALERT_HOLIDAYS=
